
pipeline{
    agent any
    
    environment{
        RELEASE='20.6'
    }
    stages{
        stage("Build"){
            agent any
            environment{
                LOG_LEVEL="INFO"
            }
            steps{
                echo " Release logs ${RELEASE} and ${LOG_LEVEL}"
            }
        }
        stage("Test"){
            steps{
                echo "Log info ${LOG_LEVEL}"
            }
        }
        stage("Deploy"){
            input{
                message 'Deploy?'
                ok 'Do it'
                parameters{
                    string{name: "TARGET_ENVIRONMENT", defaultValue: 'PROD', description: "Target the deployment environment"}
                }
            }
            steps{
                echo "Deploying release ${RELEASE} to environment ${TARGET_ENVIRONMENT}"
            }
        }
    }
    post{
        always{
            echo "Print the deployment is happend or not , success or failure"
        }
    }
}
